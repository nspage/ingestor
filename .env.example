# Copy to .env and fill in. Never commit .env.

# YouTube Data API (optional: titles, durations, channel names)
GOOGLE_API_KEY=your_youtube_data_api_key_here

# Gemini API (required to Process a transcript from the helper)
GEMINI_API_KEY=your_gemini_api_key_here

# Cloudflare Worker that holds the queue, channels, and notes
WORKER_BASE_URL=https://yt-pipeline-worker.your-subdomain.workers.dev
WORKER_API_SECRET=your_strong_api_secret_here
PUBSUB_CALLBACK_URL=https://yt-pipeline-worker.your-subdomain.workers.dev/youtube/pubsub

# Optional: Telegram delivery of finished notes
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: daily digest email (Resend)
RESEND_API_KEY=your_resend_api_key_here
EMAIL_TO=you@example.com
TIMEZONE=UTC

# Optional: Trigger.dev local runner (not required for the helper path)
TRIGGER_SECRET_KEY=your_trigger_secret_key_here
TRIGGER_PROJECT_ID=your_trigger_project_id_here
TRIGGER_ACCESS_TOKEN=your_trigger_access_token_here
