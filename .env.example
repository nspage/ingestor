# Copy to .env and fill in. Never commit .env.
# You pay for your own Cloudflare account and your own model API. Nothing is billed to the author.

# --- required ---

# OpenRouter (preferred). Process / classify / visual calls are billed to this key.
# Easier: paste it in the extension Settings (saved to ~/.ingestor/secrets.env).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback if OpenRouter is unset. Gemini Web import in the extension does not use this.
GEMINI_API_KEY=

# Cloudflare Worker that holds YOUR queue, channels, and notes (deploy worker/ yourself)
WORKER_BASE_URL=https://yt-pipeline-worker.your-subdomain.workers.dev
WORKER_API_SECRET=your_strong_api_secret_here
PUBSUB_CALLBACK_URL=https://yt-pipeline-worker.your-subdomain.workers.dev/youtube/pubsub

# --- optional ---

# YouTube Data API (titles, durations, channel names)
GOOGLE_API_KEY=

# Telegram delivery of finished notes
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
