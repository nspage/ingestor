{
  "manifest_version": 3,
  "name": "YT LLM Pipeline Assistant",
  "version": "2.17",
  "description": "Review YouTube videos and send them through your local knowledge pipeline.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.youtube.com/*",
    "https://gemini.google.com/*",
    "https://*.workers.dev/*",
    "https://img.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["gemini.js"]
    }
  ],
  "action": {
    "default_title": "Open Pipeline"
  },
  "commands": {
    "toggle-pipeline": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Open or close the pipeline side panel"
    },
    "pick-videos": {
      "suggested_key": {
        "default": "Ctrl+Shift+1",
        "mac": "Command+Shift+1"
      },
      "description": "Pick YouTube videos to send to Pending"
    }
  }
}
